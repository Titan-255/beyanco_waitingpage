# BEYANCO AI — Environment Configuration

# Next.js Server Port
PORT=3000

# Base URL for API calls & Email assets
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Generation Provider: 'demo' | 'openai' | 'replicate' | 'stability' | 'comfyui'
IMAGE_PROVIDER=demo

# Optional Remote AI Provider Credentials
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
STABILITY_API_KEY=
LOCAL_COMFYUI_URL=http://127.0.0.1:8188

# Storage Configuration: 'local' | 's3'
STORAGE_DRIVER=local

# ----------------------------------------------------------------------
# Transactional Email Configuration (Resend API)
# ----------------------------------------------------------------------
# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender address in Resend (e.g. notifications@beyanco.com)
# For development/testing on Resend free tier, you can use: onboarding@resend.dev
FROM_EMAIL="Beyanco <notifications@beyanco.com>"

# Administrator notification email recipient
ADMIN_NOTIFICATION_EMAIL="akash@beyanco.com"
