# BEYANCO AI — Environment Configuration

# Next.js Server Port
PORT=3000

# Base URL for API calls & Email assets
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Generation Provider: 'demo' | 'openai' | 'replicate' | 'stability' | 'comfyui'
IMAGE_PROVIDER=demo

# Optional Remote AI Provider Credentials
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
STABILITY_API_KEY=
LOCAL_COMFYUI_URL=http://127.0.0.1:8188

# Storage Configuration: 'local' | 's3'
STORAGE_DRIVER=local

# ----------------------------------------------------------------------
# Transactional Email Configuration (Official Hostinger Mail API)
# ----------------------------------------------------------------------
# Hostinger Mail API Token generated under Agentic Mail -> API Access
HOSTINGER_MAIL_API_TOKEN=

# Hostinger Mailbox Address (e.g. akash@beyanco.com)
HOSTINGER_MAILBOX="akash@beyanco.com"

# Hostinger Mailbox Resource ID (obtained from /api/v1/me, e.g. AC834394107983f7f9e8f2d64ded2c)
HOSTINGER_MAILBOX_RESOURCE_ID=

# Administrator notification email recipient
ADMIN_NOTIFICATION_EMAIL="akash@beyanco.com"
